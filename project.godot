; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Rootfall"
config/version="0.1"
run/main_scene="uid://44gkbea22p70"
config/features=PackedStringArray("4.6", "Forward Plus")
boot_splash/stretch_mode=4
boot_splash/image="uid://b8nh680ori21t"
config/icon="uid://cvmdf72pw2bpy"

[autoload]

SettingsManager="*res://Scripts/SettingsManager.gd"
DungeonManager="*res://dungeon/scripts/DungeonManager.gd"
GameManager="*uid://bxu7l7ke3kn5x"
InventoryManager="*uid://c2n0gd8g11e3u"
CraftingManager="*uid://cpv77nj6xguny"
WeaponSystem="*res://Scripts/WeaponSystem.gd"
ScreenFade="*res://Scenes/ScreenFade.gd"
SoundManager="*res://Scenes/SoundManager.gd"
MobRegistry="*res://Scripts/enemies/mob_registry.gd"
ToolSelectionManager="*res://Scripts/ToolSelectionManager.gd"
SpellManager="*res://Scripts/SpellManager.gd"
DissolutionHelper="*res://Scripts/dissolution_helper.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="ignore"
window/vsync/vsync_mode=0

[editor_plugins]

enabled=PackedStringArray("res://addons/export_include_recipes_items/plugin.cfg")

[filesystem]

import/blender/enabled=false

[global_group]

enemy=""

